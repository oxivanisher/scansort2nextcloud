# Secrets for docker-compose.yml. Copy to .env (never commit .env).

# User of this stack: both containers run as this UID/GID (chown ./data and ./inbox to it).
STACK_UID=1000
STACK_GID=1000

# FTP/FTPS login for the scanner (user "scanner"); without it, FTP logins are impossible.
# Not used with the SFTP override. Avoid " and \ (the password goes into a JSON file).
FTP_PASSWORD=change-me
# IP address the scanner uses to reach this host (needed for passive FTP)
FTP_PUBLIC_ADDRESS=

# Optional FTPS (see docker-compose.ftps.yml for creating ./certs):
# COMPOSE_FILE=docker-compose.yml:docker-compose.ftps.yml
# FTP_TLS_MODE=1          # 1 = explicit TLS required (port 21), 2 = implicit TLS, 0 = optional
# FTP_MIN_TLS_VERSION=12  # 12 = TLS 1.2, 13 = TLS 1.3; use 12 for older scanners

# Optional SFTP with key login instead of FTP (see docker-compose.sftp.yml; mkdir/chown ./sftp first):
# COMPOSE_FILE=docker-compose.yml:docker-compose.sftp.yml
# SFTP_PUBLIC_KEY=ssh-ed25519 AAAA... scanner   # the scanner's public key, one line
# SFTP_PORT=2222
# Nextcloud login of the dedicated machine account (e.g. scanbot) and its app password
# (log in as that user → Settings → Security → Devices & sessions → Create new app password)
NC_USER=scanbot
NC_APP_PASSWORD=
# Web UI password (login user: webui.username in config.yaml, default "admin"). Create the hash with
#   docker run --rm -it ghcr.io/oxivanisher/scansort2nextcloud:latest scansort hash-password
# Keep the single quotes: the hash contains "$" characters.
WEBUI_PASSWORD_HASH='$argon2id$v=19$...'

# e.g. `openssl rand -base64 48`
SESSION_SECRET=
