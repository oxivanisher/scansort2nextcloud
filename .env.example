# Secrets for docker-compose.yml. Copy to .env (never commit .env).

# User of this stack: both containers run as this UID/GID (chown ./data and ./inbox to it).
STACK_UID=1000
STACK_GID=1000

# FTP login for the scanner (user "scanner"). Avoid " and \ (the password goes into a JSON file).
FTP_PASSWORD=change-me
# IP address the scanner uses to reach this host (needed for passive FTP)
FTP_PUBLIC_ADDRESS=
# Nextcloud login of the dedicated machine account (e.g. scanbot) and its app password
# (log in as that user → Settings → Security → Devices & sessions → Create new app password)
NC_USER=scanbot
NC_APP_PASSWORD=
# docker compose run --rm --no-deps scansort scansort hash-password
# Keep the single quotes: the hash contains "$" characters.
WEBUI_PASSWORD_HASH='$argon2id$v=19$...'

# e.g. `openssl rand -base64 48`
SESSION_SECRET=
